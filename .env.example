# Copy this file to API/.env and fill in your keys.

COMFLY_API_KEY=sk-your-comfly-key
MODELSCOPE_API_KEY=ms-your-modelscope-key

# Optional: multiple local ComfyUI backends, comma-separated.
COMFYUI_INSTANCES=127.0.0.1:8188,127.0.0.1:4090

# Optional upstream configuration.
COMFLY_BASE_URL=https://ai.comfly.chat
CHAT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-2
CHAT_MODELS=gpt-4o-mini,gemini-3.1-flash-image-preview-2k
IMAGE_MODELS=nano-banana-pro
MODELSCOPE_CHAT_MODELS=Qwen/Qwen3-235B-A22B,MiniMax/MiniMax-M2.7:MiniMax
SYSTEM_PROMPT=You are a helpful assistant.
MAX_HISTORY_MESSAGES=30
REQUEST_TIMEOUT=120
IMAGE_POLL_INTERVAL=2
